  "design_identity": {
    "role": "Bruiser / Tactical Support / Resource Fighter",
    "combat_style": "Generates Capital, deploys Cart modes, bursts with Mammonite, and reshapes combat through logistics and impact.",
    "strengths": [
      "Strong single-target burst",
      "Distinct battlefield control through cart mechanics",
      "Flexible support through Supply Station",
      "Can convert momentum into damage"
    ],
    "weaknesses": [
      "Needs setup to reach peak value",
      "Depends on Pushcart for several strong tools",
      "Less consistent if denied Capital generation"
    ]
  },

  "core_systems": {
    "capital": {
      "description": "Capital is the Merchant's combat economy resource.",
      "resource_name": "Capital",
      "maximum_charges": 3,
      "generation_rules": [
        "Loud Exclamation grants 1 Capital",
        "Appraisal grants 1 Capital if the analyzed target dies",
        "Supply Station may grant 1 Capital depending on Cart Mode",
        "A source can generate Capital only once per turn unless explicitly stated otherwise"
      ]
    },
    "cart_system": {
      "description": "Pushcart enables Cart-based abilities. Change Cart selects the current operational mode.",
      "modes": [
        "Cargo Cart",
        "Battle Cart",
        "Utility Cart"
      ]
    }
  },

