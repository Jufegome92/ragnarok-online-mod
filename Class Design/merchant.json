{
  "class": "Novice",
  "subclass": "Merchant",

  "granted_at_character_level": 2,

  "hit_points": {
    "base": 8,
    "per_level": 8,
    "constitution_modifier_applies": true,
    "formula_note": "At Merchant levels, gain 8 HP + Constitution modifier per level."
  },

  "spellcasting_ability": "Charisma",
  "spellcasting_save_dc_formula": "8 + proficiency_bonus + charisma_modifier",

  "mana_points": {
    "base_formula": "4 + (2 * character_level)",
    "modifier_scaling": "character_level * floor(spellcasting_modifier / 2)",
    "total_formula": "(4 + (2 * character_level)) + (character_level * floor(spellcasting_modifier / 2))",
    "formula_note": "For Merchant, spellcasting_modifier uses Charisma."
  },

