{
  "class": "Ninja",
  "archetype": "Extended",
  "granted_at_character_level": 1,

  "hit_points": {
    "base": 8,
    "per_level": 6,
    "constitution_modifier_applies": true,
    "formula_note": "At Ninja levels, gain 6 HP + Constitution modifier per level."
  },

  "spellcasting_ability": "Wisdom",
  "spellcasting_save_dc_formula": "8 + proficiency_bonus + wisdom_modifier",

  "mana_points": {
    "base_formula": "4 + (2 * character_level)",
    "modifier_scaling": "character_level * floor(spellcasting_modifier / 2)",
    "total_formula": "(4 + (2 * character_level)) + (character_level * floor(spellcasting_modifier / 2))",
    "formula_note": "For Ninja, spellcasting_modifier uses Wisdom."
  },

  "proficiencies": {
    "saving_throws": [
      "Dexterity",
      "Wisdom"
    ],
    "armor": [
      "Light Armor"
    ],
    "weapons": [
      "Dagger",
      "Shortsword",
      "Scimitar",
      "Quarterstaff",
      "Unarmed"
    ],
    "tools": [],
    "skills": {
      "fixed": [
        "Stealth",
        "Acrobatics"
      ],
      "expertise": 1
    }
  },

  "design_identity": {
    "role": "Skirmisher / Backline Hunter / Ninjutsu Hybrid",
    "combat_style": "Switches between Throwing, Shadow Arts, and Ninpou to harass, reposition, control fields, and finish targets.",
    "strengths": [
      "Excellent mobility",
      "Strong anti-backline pressure",
      "Flexible mix of physical and magical tools",
      "Can switch between safe pressure and high-commitment burst"
    ],
    "weaknesses": [
      "Needs smart stance usage to maximize value",
      "Less durable when caught in direct attrition",
      "Final Strike is highly committal"
    ]
  },

  "core_systems": {
    "ninja_stances": {
      "description": "The Ninja uses three combat stances. Only one stance may be active at a time.",
      "stances": [
        "Throwing Mastery",
        "Shadow Arts",
        "Ninpou Training"
      ],
      "rules": {
        "first_stance_change_each_turn_is_free": true,
        "free_change_consumes_bonus_action": false,
        "additional_stance_changes_same_turn_allowed": false,
        "off_branch_skills_remain_usable": true,
        "matching_stance_grants_bonus_or_premium_effects": true
      }
    },
    "ninja_discipline_scaling": {
      "global_milestones": [
        1,
        5,
        9
      ]
    },
    "soul_system": {
      "description": "Soul is the central concentration buff of the class and amplifies every branch rather than creating a separate branch."
    }
  },

  "progression": {
    "level_1": {
      "class_state": "Ninja",
