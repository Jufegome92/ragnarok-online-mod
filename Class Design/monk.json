{
  "base_class": "Novice",
  "first_job": "Acolyte",
  "second_job": "Monk",

  "granted_at_character_level": 6,
  "second_job_selector_group": [
    "Priest",
    "Monk"
  ],

  "inherits_from_first_job": {
    "spellcasting_ability": "Wisdom",
    "spellcasting_save_dc_formula": "8 + proficiency_bonus + wisdom_modifier",
    "mana_points_formula": "(4 + (2 * character_level)) + (character_level * floor(spellcasting_modifier / 2))",
    "retained_acolyte_systems": [
      "Sacred Doctrine",
      "Restoration",
      "Sanctuary Rite",
      "Benediction",
      "Judgement",
      "Aqua Benedicta",
      "Pilgrim's Passage"
    ]
  },

  "design_identity": {
    "role": "Martial Burst / Combo Specialist / Backline Hunter",
    "combat_style": "Build Spirit, choose between pressure or combo routes, and convert rhythm into explosive finishers.",
    "strengths": [
      "Strong anti-backline pressure",
      "Powerful single-target combo path against elites",
      "Excellent mobility",
      "High burst through Spirit conversion"
    ],
    "weaknesses": [
      "Needs setup for peak value",
      "Combo route is weaker against fragile targets",
      "Can feel exposed if Spirit and stance choice are mismanaged"
    ]
  },

  "core_systems": {
    "spirit_spheres": {
      "description": "Spirit Spheres are the Monk's main combat resource.",
      "resource_name": "Spirit Spheres",
      "maximum_charges": 5,
      "generation_rules": [
        "Call Spirits generates Spirit Spheres directly",
        "Absorb Spirits generates 1 Spirit Sphere when its condition is met",
        "Martial Flow can generate 1 Spirit Sphere on success",
        "Dangerous Soul Collect is the emergency burst generator"
      ]
    },
    "martial_stances": {
      "description": "Only one Monk stance can be active at a time.",
      "stances": [
        "Iron Hand",
        "Dodge",
        "Steel Body"
      ]
    },
    "combo_windows": {
      "description": "Combo Arts use temporary windows instead of action-combat speed.",
      "statuses": [
        "Finish Window",
        "Crush Window"
      ]
    },
    "martial_flow": {
      "description": "Martial Flow is the Monk's controlled randomness engine and only supports the combo route.",
      "trigger_rules": {
        "after_attack_action_and_follow_up_strike_roll_1d6": true,
        "if_no_attacks_hit_trigger_threshold": "6+",
        "if_one_attack_hit_trigger_threshold": "5+",
        "if_both_attacks_hit_trigger_threshold": "4+"
      },
      "on_success_choose_one": [
        "Gain 1 Spirit Sphere",
        "Gain Finish Window if you do not already have it",
        "Gain +1 AC until your next turn"
      ]
    }
  },

