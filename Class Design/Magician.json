    {
      "id": "magician_element_bolt",
      "name": "Element Bolt",
      "learned_at_level": 2,
      "category": "Attack",
      "action_type": "Action",
      "base_cost_mp": 2,
      "requires_concentration": false,
      "requires": [
        "Valid target in line of sight"
      ],
      "duration": "Instant",
      "range": "18m",
      "description": "El Magician condensa energía elemental en una secuencia de impactos sobre un solo objetivo. La progresión principal del hechizo está en su número de impactos, simulando los niveles de Bolt de Ragnarok.",
      "base_effects": {
        "delivery_method": "Single spell attack roll; on hit, all impacts connect",
        "damage_per_hit": "1d4",
        "spellcasting_modifier_applies_once": true,
        "number_of_hits": 2
      },
      "element_variants": {
        "Fire": {
          "identity": "Highest raw single-target pressure",
          "damage_type": "Fire",
          "base_rider": "No additional rider at base tier",
          "intensified_rider": "Add +1 flat damage per hit",
          "overload_rider": "On hit, target must pass a Constitution save or become Burned for 1d4 turns"
        },
        "Cold": {
          "identity": "Single-target slowing and setup",
          "damage_type": "Cold",
          "base_rider": "If at least half the hits land, target becomes Chilled for 1 turn",
          "intensified_rider": "Chilled duration becomes 2 turns",
          "overload_rider": "If target is already Chilled, it must pass a Constitution save or become Rooted for 1 turn"
        },
        "Lightning": {
          "identity": "Disruption and volatility",
          "damage_type": "Lightning",
          "base_rider": "If at least half the hits land, target becomes Shocked for 1 turn",
          "intensified_rider": "Shocked duration becomes 2 turns",
          "overload_rider": "One extra impact arcs to a secondary enemy within 3m of the main target"
        },
        "Force": {
          "identity": "Most reliable universal option",
          "damage_type": "Force",
          "base_rider": "+1 spell attack bonus for this cast",
          "intensified_rider": "Add +1 flat damage per hit",
          "overload_rider": "Gains +2 spell attack bonus for this cast"
        }
      },
      "overchannel": {
        "base": {
          "total_mp_cost": 2,
          "effect": "Use Element Bolt with its current milestone hit count."
        },
        "intensified": {
          "total_mp_cost": 4,
          "effect": "+1 hit and unlock the intensified rider of the chosen element."
        },
        "overload": {
          "total_mp_cost": 6,
          "effect": "+2 hits and unlock the overload rider of the chosen element."
        }
      },
      "scaling": {
        "type": "multi_hit_progression",
        "milestones": [
