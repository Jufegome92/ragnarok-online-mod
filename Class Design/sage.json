  "design_identity": {
    "role": "Scholar-Caster / Anti-Mage / Field Controller / Enchanter",
    "combat_style": "Analyzes enemies, enchants allies, manipulates elemental fields, and interferes with hostile magic",
    "strengths": [
      "Excellent magical utility",
      "Strong anti-caster tools",
      "Offensive support through weapon enchantment",
      "Excellent battlefield shaping"
    ],
    "weaknesses": [
      "Lower direct damage ceiling than Wizard",
      "Relies on setup and system mastery",
      "Less explosive if forced into simple damage races"
    ]
  },

  "core_systems": {
    "scholarly_magic": {
      "description": "The Sage does not simply cast stronger magic; it studies, redirects, enchants, and denies magic.",
      "pillars": [
        "Arcane Analysis",
        "Earth Sorcery",
        "Elemental Imbue",
        "Arcane Technique",
        "Spell Control",
        "Geomantic Field",
        "Arcane Denial"
      ]
    },
    "arcane_technique_rules": {
      "description": "Arcane Technique is a family of stances. Only one Arcane Technique stance can be active at a time.",
      "stances": [
        "Advanced Book",
        "Free Cast",
        "Auto Spell"
      ]
    },
    "auto_spell_rules": {
      "description": "Auto Spell uses a reduced Trigger Bolt rather than the full Element Bolt spell.",
      "trigger_bolt_definition": {
        "uses_same_element_as_selected_stance": true,
        "uses_element_bolt_base_rider_only": true,
        "cannot_use_intensified_or_overload": true,
        "cost_mp": 0,
        "max_triggers_per_turn": 1,
        "hit_count_rule": "Trigger Bolt uses half of the current Element Bolt hit count, rounded up"
      }
    }
  },

